Meta.DisplayName=Aloft
Meta.Description=Aloft Dedicated Server
Meta.Arch=x86_64
Meta.Author=Tyqo
Meta.URL=https://store.steampowered.com/app/1660080/Aloft/
Meta.MinAMPVersion=2.4.6.6
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported

Meta.OS=2
Meta.ConfigManifest=aloftconfig.json
Meta.MetaConfigManifest=aloftmetaconfig.json
Meta.ConfigRoot=aloft.kvp

Meta.DisplayImageSource=steam:1660080

App.DisplayName=Aloft
App.AdminMethod=STDIO
App.HasReadableConsole=true
App.HasWritableConsole=true

App.RootDir=./Aloft/
App.BaseDirectory=./Aloft/
App.WorkingDir=.
App.ExecutableLinux=steam

App.CommandLineArgs=-applaunch 1660080 -batchmode -nographics -server load#{{MAPNAME}}# log#{{LOG}}# disablevideo#true# servername#{{SERVERNAME}}# isvisible#{{VISIBLE}}# playercount#{{MAXPLAYERS}}# serverport#{{PORT}}#

App.WindowsCommandLineArgs=

App.ApplicationReadyMode=ConsoleRegex
Console.AppReadyRegex=.*Room Code.*
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.AppReadyRegex=.*Room Code.*

App.ExitMethod=SIGINT
App.ExitTimeout=30

App.ApplicationIPBinding=0.0.0.0
App.PrimaryApplicationPortRef=GamePort

App.MaxUsers=8

App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False

App.SupportsUniversalSleep=False

App.Ports=@IncludeJson[aloftports.json]
App.UpdateSources=@IncludeJson[aloftupdates.json]

App.EnvironmentVariables={}
